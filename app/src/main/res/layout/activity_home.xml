<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top accent stripe -->
        <View
            android:id="@+id/accentStripe"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@color/auth_primary_blue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Decorative blob top-right -->
        <View
            android:id="@+id/decorCircle"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/bg_circle_blob"
            android:alpha="0.08"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-60dp" />

        <!-- Role chip -->
        <TextView
            android:id="@+id/tvRoleTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/role_admin"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/auth_primary_blue"
            android:background="@drawable/bg_tag_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toBottomOf="@id/accentStripe"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="36dp"
            android:layout_marginStart="28dp" />

        <!-- Greeting -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="-0.02"
            android:text="@string/greeting_user"
            android:textColor="@color/auth_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            app:layout_constraintStart_toStartOf="@id/tvRoleTag"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="28dp"
            app:layout_constraintTop_toBottomOf="@id/tvRoleTag" />

        <!-- Header divider -->
        <View
            android:id="@+id/headerDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/auth_divider"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="28dp" />

        <!-- STATS ROW -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:weightSum="3"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Total Documents -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="14dp"
                android:layout_marginEnd="8dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/statDocuments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_documents_count"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/auth_primary_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_documents_label"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:textColor="@color/auth_text_secondary" />
            </LinearLayout>

            <!-- Pending Approvals -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="14dp"
                android:layout_marginEnd="8dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/statPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_pending_count"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/auth_primary_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_pending_label"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:textColor="@color/auth_text_secondary" />
            </LinearLayout>

            <!-- Activity Today -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="14dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/statActivityToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_activity_today_count"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/auth_primary_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_activity_today_label"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:textColor="@color/auth_text_secondary" />
            </LinearLayout>

        </LinearLayout>

        <!-- QUICK ACTIONS CARD -->
        <LinearLayout
            android:id="@+id/quickActionsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_elevated"
            android:padding="24dp"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/statsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_actions_title"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/auth_text_secondary"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnUploadDocument"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/quick_action_upload"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:backgroundTint="@color/auth_primary_blue"
                android:textColor="@android:color/white"
                android:stateListAnimator="@null"
                android:elevation="4dp" />

            <Button
                android:id="@+id/btnBrowseRepository"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/quick_action_browse"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/white"
                android:textColor="@color/auth_primary_blue"
                android:layout_marginTop="10dp"
                android:stateListAnimator="@null"
                android:foreground="?attr/selectableItemBackground"
                android:elevation="2dp" />

            <Button
                android:id="@+id/btnPendingApprovals"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/quick_action_pending"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/white"
                android:textColor="@color/auth_primary_blue"
                android:layout_marginTop="10dp"
                android:stateListAnimator="@null"
                android:foreground="?attr/selectableItemBackground"
                android:elevation="2dp" />

        </LinearLayout>

        <!-- DOCUMENT TOOLS CARD -->
        <LinearLayout
            android:id="@+id/docToolsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_elevated"
            android:padding="24dp"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/quickActionsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/document_tools_title"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/auth_text_secondary"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginBottom="20dp" />

            <!-- 2-column grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnActivityLogs"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/doc_tool_activity_logs"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/auth_primary_blue"
                    android:textColor="@android:color/white"
                    android:stateListAnimator="@null"
                    android:elevation="4dp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnManageUsers"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/doc_tool_manage_users"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@android:color/white"
                    android:textColor="@color/auth_primary_blue"
                    android:stateListAnimator="@null"
                    android:foreground="?attr/selectableItemBackground"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ACCOUNT CARD -->
        <LinearLayout
            android:id="@+id/accountCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_elevated"
            android:padding="24dp"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/docToolsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_title"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/auth_text_secondary"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnGoUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/account_update_details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:backgroundTint="@color/auth_primary_blue"
                android:textColor="@android:color/white"
                android:stateListAnimator="@null"
                android:elevation="4dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/account_logout"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/white"
                android:textColor="@color/auth_primary_blue"
                android:layout_marginTop="10dp"
                android:stateListAnimator="@null"
                android:foreground="?attr/selectableItemBackground"
                android:elevation="2dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>