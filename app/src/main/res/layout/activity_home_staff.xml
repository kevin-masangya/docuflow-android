<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:fillViewport="true"
    tools:context=".home_staff">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top accent stripe -->
        <View
            android:id="@+id/accentStripe"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@color/auth_primary_blue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Decorative blob -->
        <View
            android:id="@+id/decorCircle"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-60dp"
            android:alpha="0.08"
            android:background="@drawable/bg_circle_blob"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Role -->
        <TextView
            android:id="@+id/tvRoleTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_tag_chip"
            android:letterSpacing="0.15"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="STAFF"
            android:textColor="@color/auth_primary_blue"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accentStripe" />

        <!-- Staff Name -->
        <TextView
            android:id="@+id/tvStaffName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="28dp"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="2dp"
            android:text="John Doe"
            android:textColor="@color/auth_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvRoleTag"
            app:layout_constraintTop_toBottomOf="@id/tvRoleTag"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider -->
        <View
            android:id="@+id/headerDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="28dp"
            android:background="@color/auth_divider"
            app:layout_constraintTop_toBottomOf="@id/tvStaffName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Stats Row -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Stat Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvStatMyDocs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textColor="@color/auth_primary_blue"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repository Docs"
                    android:textColor="@color/auth_text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Stat Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_elevated"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvStatPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/auth_primary_blue"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textColor="@color/auth_text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Stat Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_elevated"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvStatApproved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18"
                    android:textColor="@color/auth_primary_blue"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approved"
                    android:textColor="@color/auth_text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />
            </LinearLayout>

        </LinearLayout>

        <!-- QUICK ACTIONS -->
        <LinearLayout
            android:id="@+id/quickActionsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_card_elevated"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/statsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:text="QUICK ACTIONS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/auth_text_secondary"
                android:letterSpacing="0.12"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnUploadDocument"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="＋ Upload Document"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/auth_primary_blue"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnBrowseRepository"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Browse Repository"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/auth_primary_blue"
                android:backgroundTint="@android:color/white"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnMySubmissions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="My Submissions"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/auth_primary_blue"
                android:backgroundTint="@android:color/white"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- DOCUMENT TOOLS -->
        <LinearLayout
            android:id="@+id/docToolsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_card_elevated"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/quickActionsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:text="DOCUMENT TOOLS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/auth_text_secondary"
                android:letterSpacing="0.12"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnActivityLogs"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Activity Logs"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/auth_primary_blue"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- ACCOUNT -->
        <LinearLayout
            android:id="@+id/accountCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_card_elevated"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/docToolsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:text="ACCOUNT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/auth_text_secondary"
                android:letterSpacing="0.12"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnGoUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Update Account Details →"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/auth_primary_blue"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Logout"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/auth_primary_blue"
                android:backgroundTint="@android:color/white"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>