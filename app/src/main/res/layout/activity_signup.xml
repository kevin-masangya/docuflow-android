<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg">

    <!-- Top accent stripe -->
    <View
        android:id="@+id/accentStripe"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="@color/auth_primary_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative blob top-right (reusing bg_circle_blob) -->
    <View
        android:id="@+id/decorCircle"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_circle_blob"
        android:alpha="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp" />

    <!-- "NEW ACCOUNT" chip (reusing bg_tag_chip) -->
    <TextView
        android:id="@+id/tvSignupTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DOCUFLOW"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="@color/auth_primary_blue"
        android:background="@drawable/bg_tag_chip"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/accentStripe"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="36dp"
        android:layout_marginStart="28dp" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create account"
        android:textSize="40sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/auth_text_primary"
        app:layout_constraintTop_toBottomOf="@id/tvSignupTag"
        app:layout_constraintStart_toStartOf="@id/tvSignupTag"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set up your staff account"
        android:textSize="14sp"
        android:textColor="@color/auth_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        android:layout_marginTop="4dp" />

    <!-- Divider under header -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/auth_divider"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="28dp" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <!-- Form card (reusing bg_card_elevated) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_elevated"
            android:padding="24dp"
            android:elevation="8dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp">

            <!-- USERNAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USERNAME"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/auth_text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext_styled"
                android:hint="your_username (letters only, min 4)"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="15sp"
                android:textColor="@color/auth_text_primary"
                android:textColorHint="@color/auth_hint" />

            <TextView
                android:id="@+id/tvUsernameError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CC2200"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="⚠ Username must contain letters only"
                android:layout_marginTop="4dp" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/auth_text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext_styled"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="15sp"
                android:textColor="@color/auth_text_primary"
                android:textColorHint="@color/auth_hint" />

            <!-- Thin divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- FIRST + LAST NAME row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIRST NAME"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:textColor="@color/auth_text_primary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext_styled"
                        android:hint="First"
                        android:inputType="textPersonName"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textSize="15sp"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_hint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAST NAME"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:textColor="@color/auth_text_primary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext_styled"
                        android:hint="Last"
                        android:inputType="textPersonName"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textSize="15sp"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- AGE + BIRTHDATE row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AGE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:textColor="@color/auth_text_primary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext_styled"
                        android:hint="18–60"
                        android:inputType="number"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textSize="15sp"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_hint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BIRTHDATE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:textColor="@color/auth_text_primary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etBirthdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext_styled"
                        android:hint="DD/MM/YYYY"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:drawableTint="@color/auth_primary_blue"
                        android:inputType="none"
                        android:textSize="15sp"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- ADDRESS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADDRESS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/auth_text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext_styled"
                android:hint="Street, City, ZIP (max 60 chars)"
                android:inputType="textPostalAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:maxLength="60"
                android:textSize="15sp"
                android:textColor="@color/auth_text_primary"
                android:textColorHint="@color/auth_hint" />

            <!-- Thin divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/auth_text_primary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_edittext_styled"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textSize="15sp"
                    android:textColor="@color/auth_text_primary"
                    android:textColorHint="@color/auth_hint" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Show/Hide password"
                    app:tint="@color/auth_primary_blue" />
            </LinearLayout>

            <!-- Password requirements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvReqUpper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="· 1 uppercase"
                    android:textSize="11sp"
                    android:textColor="@color/auth_text_secondary" />

                <TextView
                    android:id="@+id/tvReqSymbol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="· 1 symbol"
                    android:textSize="11sp"
                    android:textColor="@color/auth_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvReqNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="· 1 number"
                    android:textSize="11sp"
                    android:textColor="@color/auth_text_secondary" />

                <TextView
                    android:id="@+id/tvReqLength"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="· 8+ characters"
                    android:textSize="11sp"
                    android:textColor="@color/auth_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CC2200"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="⚠ Password is not strong enough"
                android:layout_marginTop="4dp" />

            <!-- CONFIRM PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRM PASSWORD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/auth_text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_edittext_styled"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textSize="15sp"
                    android:textColor="@color/auth_text_primary"
                    android:textColorHint="@color/auth_hint" />

                <ImageView
                    android:id="@+id/ivToggleConfirmPassword"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Show/Hide confirm password"
                    app:tint="@color/auth_primary_blue" />
            </LinearLayout>

            <!-- Thin divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/auth_divider"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <!-- TERMS -->
            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I accept the Terms and Conditions"
                android:textSize="13sp"
                android:textColor="@color/auth_text_primary"
                android:buttonTint="@color/auth_primary_blue" />

            <TextView
                android:id="@+id/tvTermsError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CC2200"
                android:textSize="11sp"
                android:visibility="gone"
                android:text="⚠ You must accept the Terms and Conditions"
                android:layout_marginTop="4dp" />

            <!-- REGISTER BUTTON -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Create account  →"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:backgroundTint="@color/auth_primary_blue"
                android:textColor="@android:color/white"
                android:layout_marginTop="20dp"
                android:stateListAnimator="@null"
                android:elevation="4dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/auth_primary_blue"
                android:visibility="gone"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Login"
                android:textColor="@color/auth_primary_blue"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>