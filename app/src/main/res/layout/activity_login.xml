<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg">

    <!-- Top accent stripe -->
    <View
        android:id="@+id/accentStripe"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="@color/auth_primary_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative circle blob top-right -->
    <View
        android:id="@+id/decorCircle"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_circle_blob"
        android:alpha="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp" />

    <!-- HEADER -->
    <TextView
        android:id="@+id/tvLoginTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DOCUFLOW"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="@color/auth_primary_blue"
        android:background="@drawable/bg_tag_chip"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/accentStripe"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="36dp"
        android:layout_marginStart="28dp" />

    <TextView
        android:id="@+id/tvLoginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/auth_text_primary"
        app:layout_constraintTop_toBottomOf="@id/tvLoginTag"
        app:layout_constraintStart_toStartOf="@id/tvLoginTag"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvLoginSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign in to your document workspace"
        android:textSize="14sp"
        android:textColor="@color/auth_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvLoginTitle"
        app:layout_constraintStart_toStartOf="@id/tvLoginTitle"
        android:layout_marginTop="4dp" />

    <!-- Divider under header -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/auth_divider"
        app:layout_constraintTop_toBottomOf="@id/tvLoginSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="28dp" />

    <!-- FORM CARD -->
    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_elevated"
        android:padding="24dp"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp">

        <!-- Username label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USERNAME"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/auth_text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etLoginUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext_styled"
            android:hint="your_username"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="15sp"
            android:textColor="@color/auth_text_primary"
            android:textColorHint="@color/auth_hint" />

        <!-- Password label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSWORD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/auth_text_primary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_edittext_styled"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="15sp"
                android:textColor="@color/auth_text_primary"
                android:textColorHint="@color/auth_hint" />

            <ImageView
                android:id="@+id/ivToggleLoginPassword"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="Show/Hide password"
                app:tint="@color/auth_primary_blue" />
        </LinearLayout>

        <!-- Login button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Sign in  →"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:backgroundTint="@color/auth_primary_blue"
            android:textColor="@android:color/white"
            android:layout_marginTop="24dp"
            android:stateListAnimator="@null"
            android:elevation="4dp" />

        <!-- OR divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/auth_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  or  "
                android:textSize="12sp"
                android:textColor="@color/auth_text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/auth_divider" />
        </LinearLayout>

        <!-- Social buttons row — replace the existing LinearLayout with weightSum="2" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Google"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/auth_text_primary"
                android:layout_marginEnd="6dp"
                android:elevation="2dp"
                app:backgroundTint="@android:color/white"
                app:icon="@drawable/ic_google"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@null"
                app:strokeColor="@color/auth_divider"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFacebookSignin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Facebook"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/auth_text_primary"
                android:layout_marginStart="6dp"
                android:elevation="2dp"
                app:backgroundTint="@android:color/white"
                app:icon="@drawable/ic_facebook"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@null"
                app:strokeColor="@color/auth_divider"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp" />

        </LinearLayout>
        <ProgressBar
            android:id="@+id/loginProgressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:progressTint="@color/auth_primary_blue"
            android:indeterminateTint="@color/auth_primary_blue"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- Sign up footer -->
    <TextView
        android:id="@+id/tvGoToSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account? Sign Up"
        android:textColor="@color/auth_primary_blue"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="28dp" />

</androidx.constraintlayout.widget.ConstraintLayout>